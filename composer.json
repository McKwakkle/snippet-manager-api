{
  "name": "kellan/snippet-manager-api",
  "description": "A personal code snippet manager REST API",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "firebase/php-jwt": "^7.0",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}
